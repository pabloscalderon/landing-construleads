---
import Base from "../layouts/Base.astro";
import Boton from "../components/Boton.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { landing } from "../data/landing.js";

const { marca } = landing;
---

<Base
  titulo={`Gracias por tu consulta — ${marca.nombre}`}
  descripcion="Recibimos tus datos. Te contactamos dentro de las próximas 24 horas."
>
  <main class="relative flex min-h-[100svh] items-center justify-center overflow-hidden py-24">
    <div class="estrellas pointer-events-none absolute inset-0 opacity-60 [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,#000_20%,transparent_100%)]" aria-hidden="true"></div>
    <div class="glow left-1/2 top-1/4 h-[18rem] w-[28rem] -translate-x-1/2" aria-hidden="true"></div>

    <div class="contenedor relative flex max-w-xl flex-col items-center text-center">
      <span class="flex h-20 w-20 items-center justify-center rounded-full border border-primario/40 bg-primario/10 text-primario">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 12.5l5 5 10-11" />
        </svg>
      </span>

      <div class="mt-8">
        <Eyebrow texto="Consulta recibida" centrado />
      </div>

      <h1 class="mt-5 text-white">Gracias por tu consulta</h1>
      <p class="mt-6 text-base text-white/70 sm:text-lg">
        Te contactamos lo más rápido posible, dentro de las próximas 24&nbsp;horas.
      </p>

      <div class="mt-9">
        <Boton texto="Volver al inicio" url="/" variante="primario" />
      </div>
    </div>
  </main>
</Base>
