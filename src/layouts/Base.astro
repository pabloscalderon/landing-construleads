---
import "../styles/tokens.css";
import { landing } from "../data/landing.js";

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { meta, marca } = landing;
const { titulo = meta.titulo, descripcion = meta.descripcion } = Astro.props as Props;
---

<!doctype html>
<html lang={meta.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph para previews al compartir el anuncio -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:type" content="website" />

    <!-- Tipografía: DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap"
      rel="stylesheet"
    />

    {/*
      ============================================================
      TRACKING — PLACEHOLDERS
      ------------------------------------------------------------
      Los snippets de abajo se inyectan solos si cargás el ID en
      src/data/landing.js > meta. Si preferís pegar el código tal
      cual te lo da la plataforma, pegalo en el lugar marcado.

      Eventos a disparar en esta landing:
        · ViewContent → carga de página          (ya cableado abajo)
        · Lead        → envío del formulario     (ver CtaFinal.astro)
        · Schedule    → reunión agendada Clientify (ver CtaFinal.astro)

      PENDIENTE DE INSTALAR:
        1) META PIXEL + API DE CONVERSIONES (CAPI)
           - Pixel de navegador: cargar metaPixelId en landing.js
             o pegar acá el snippet de Events Manager.
           - CAPI: la deduplicación necesita un event_id compartido
             entre navegador y servidor. Enviar desde el servidor
             (Conversions API Gateway / endpoint propio) los mismos
             eventos ViewContent, Lead y Schedule con el mismo event_id.
             >>> PEGAR ACÁ EL SNIPPET / CONFIG DE CAPI <<<
        2) ETIQUETA DE GOOGLE ADS (gtag AW-XXXXXXXX)
           - Cargar meta.gtagId + meta.gtagConversionLead /
             meta.gtagConversionSchedule en landing.js.
             >>> O PEGAR ACÁ LA ETIQUETA DE GOOGLE ADS <<<
        3) GA4 (G-XXXXXXXXXX)
           - Cargar meta.ga4Id en landing.js.
             >>> O PEGAR ACÁ LA ETIQUETA DE GA4 <<<
        4) GTM (opcional, si se centraliza todo en el contenedor)
           - Cargar meta.gtmId en landing.js.
      ============================================================
    */}

    {meta.gtmId && (
      <script is:inline set:html={`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${meta.gtmId}');
      `} />
    )}

    {(meta.gtagId || meta.ga4Id) && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${meta.gtagId || meta.ga4Id}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          ${meta.gtagId ? `gtag('config', '${meta.gtagId}');` : ""}
          ${meta.ga4Id ? `gtag('config', '${meta.ga4Id}');` : ""}
        `} />
      </>
    )}

    {meta.metaPixelId && (
      <script is:inline set:html={`
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '${meta.metaPixelId}'); fbq('track', 'PageView');
      `} />
    )}

    {/* --- Helper de eventos: window.track('Lead', {...}) ---
        Centraliza el disparo hacia dataLayer + fbq + gtag para no repetir
        código en los componentes. Si instalás todo por GTM, alcanza con
        escuchar los eventos del dataLayer. */}
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      window.track = function (evento, datos) {
        datos = datos || {};
        // GTM / GA4 vía dataLayer
        window.dataLayer.push(Object.assign({ event: evento }, datos));
        // Meta Pixel (el mismo evento debe replicarse por CAPI con igual event_id)
        if (typeof window.fbq === 'function') { window.fbq('track', evento, datos); }
        // GA4 directo (si no se usa GTM)
        if (typeof window.gtag === 'function') { window.gtag('event', evento, datos); }
      };
      // ViewContent — carga de página
      window.track('ViewContent', { content_name: document.title });
    `} />
  </head>
  <body>
    {meta.gtmId && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${meta.gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}

    <slot />
  </body>
</html>
