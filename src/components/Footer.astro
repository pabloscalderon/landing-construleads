---
import { landing } from "../data/landing.js";
import Icono from "./Icono.astro";

const { marca, footer, nav } = landing;
const redes = footer.redes.filter((r) => r.url);
const anio = new Date().getFullYear();
---
<footer class="border-t borde-linea bg-black py-12">
  <div class="contenedor">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <span class="text-xl font-bold tracking-tight text-white">
          {marca.logoImagen
            ? <img src={marca.logoImagen} alt={marca.nombre} class="h-7 w-auto" />
            : marca.logoTexto}
        </span>
        <p class="mt-3 text-sm text-suave">{footer.texto}</p>
      </div>

      <nav class="flex flex-col gap-2.5" aria-label="Navegación del pie">
        {nav.enlaces.map((e) => (
          <a href={e.url} class="text-sm text-suave transition-colors hover:text-white">{e.texto}</a>
        ))}
      </nav>

      {redes.length > 0 && (
        <div class="flex gap-3">
          {redes.map((r) => (
            <a
              href={r.url}
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/12 text-white/70 transition-colors hover:border-primario hover:text-primario"
              aria-label={r.nombre}
              rel="noopener noreferrer"
              target="_blank"
            >
              <Icono nombre={r.icono} clase="h-5 w-5" />
            </a>
          ))}
        </div>
      )}
    </div>

    <hr class="linea mt-10" />

    <div class="mt-6 flex flex-col gap-3 text-xs text-suave sm:flex-row sm:items-center sm:justify-between">
      <p>© {anio} {marca.nombre}. Todos los derechos reservados.</p>
      <nav class="flex flex-wrap gap-5" aria-label="Enlaces legales">
        {footer.enlaces.map((e) => (
          <a href={e.url} class="transition-colors hover:text-white">{e.texto}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
