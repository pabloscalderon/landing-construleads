---
import { landing } from "../data/landing.js";
const { hero } = landing;
---
<section class="section" style="text-align:center;padding-top:5rem;">
  <div class="container" style="max-width:780px;">
    <p class="eyebrow" style="margin-bottom:1.2rem;">{hero.eyebrow}</p>
    <h1 style="margin-bottom:1.4rem;">{hero.titulo}</h1>
    <p class="muted" style="font-size:1.2rem;margin-bottom:2.2rem;">{hero.subtitulo}</p>
    <a href={hero.ctaAncla} class="btn">{hero.ctaTexto}</a>
    <p class="muted" style="margin-top:1.4rem;font-size:0.9rem;">{hero.badge}</p>
  </div>
</section>
