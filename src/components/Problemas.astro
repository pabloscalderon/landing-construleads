---
import { landing } from "../data/landing.js";
const { problemas } = landing;
---
<section class="section section--alt">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:3rem;">{problemas.titulo}</h2>
    <div class="grid grid-3">
      {problemas.items.map((item) => (
        <div class="card">
          <h3 style="margin-bottom:0.8rem;color:var(--c-primary);">{item.titulo}</h3>
          <p class="muted">{item.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
