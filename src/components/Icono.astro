---
// Íconos en línea (sin librerías). Se colorean con currentColor.
interface Props {
  nombre: string;
  clase?: string;
}
const { nombre, clase = "h-6 w-6" } = Astro.props as Props;
---
<svg
  class={clase}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {nombre === "planilla" && (
    <>
      <rect x="3.5" y="3" width="17" height="18" rx="2" />
      <path d="M3.5 8.5h17M9 8.5V21M3.5 14.5h17" />
    </>
  )}
  {nombre === "telefono" && (
    <>
      <path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z" />
      <path d="M15.5 3.5a5 5 0 0 1 5 5" />
    </>
  )}
  {nombre === "papel" && (
    <>
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
      <path d="M14 3v5h5" />
      <path d="M9.5 13.5l5 5M14.5 13.5l-5 5" />
    </>
  )}
  {nombre === "mapa" && (
    <>
      <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.5" />
    </>
  )}
  {nombre === "camara" && (
    <>
      <path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z" />
      <circle cx="12" cy="13.5" r="3.5" />
    </>
  )}
  {nombre === "reloj" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5.2l3.2 2" />
    </>
  )}
  {nombre === "check" && <path d="M4.5 12.5l5 5 10-11" />}
  {nombre === "linkedin" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <path d="M7.5 10.5V17M7.5 7.6v.1M11.5 17v-3.6a2.4 2.4 0 0 1 4.8 0V17" />
    </>
  )}
  {nombre === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.2 6.9v.1" />
    </>
  )}
  {nombre === "whatsapp" && (
    <>
      <path d="M3.5 20.5l1.3-4a8 8 0 1 1 3.2 3.1l-4.5.9Z" />
      <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5.6 0 1-.5 1-1 0-.3-.2-.6-.5-.7l-1.3-.5-1 1a5.2 5.2 0 0 1-2.5-2.5l1-1-.5-1.3c-.1-.3-.4-.5-.7-.5-.5 0-1 .4-1 1Z" />
    </>
  )}
</svg>
