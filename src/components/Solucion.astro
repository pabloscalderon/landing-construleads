---
import { landing } from "../data/landing.js";
import Boton from "./Boton.astro";
import Eyebrow from "./Eyebrow.astro";
import Icono from "./Icono.astro";

const { solucion, nav } = landing;
---
<section id="como-funciona" class="seccion relative overflow-hidden">
  <div class="glow right-[-6rem] top-10 h-[18rem] w-[22rem]" aria-hidden="true"></div>

  <div class="contenedor relative">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <Eyebrow texto={solucion.eyebrow} centrado />
      <h2 class="mt-5 text-white">{solucion.titulo}</h2>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {solucion.items.map((item, i) => (
        <article class="group relative flex flex-col rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.06] to-transparent p-8 transition-colors hover:border-primario/50">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl icono-destacado">
            <Icono nombre={item.icono} clase="h-7 w-7" />
          </span>
          <span class="mt-7 text-xs font-medium tracking-[0.18em] text-suave">0{i + 1}</span>
          <h3 class="mt-2 text-white">{item.titulo}</h3>
          <p class="mt-3 text-sm text-white/65">{item.texto}</p>
        </article>
      ))}
    </div>

    <div class="mt-12 flex justify-center">
      <Boton texto={nav.cta.texto} url={nav.cta.url} variante="primario" />
    </div>
  </div>
</section>
