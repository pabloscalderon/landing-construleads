---
import { landing } from "../data/landing.js";
const { proceso } = landing;
---
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:3rem;">{proceso.titulo}</h2>
    <div class="grid grid-3">
      {proceso.pasos.map((p) => (
        <div class="card">
          <div style="font-family:var(--font-display);font-size:2.2rem;font-weight:700;color:var(--c-primary);margin-bottom:0.6rem;">{p.n}</div>
          <h3 style="margin-bottom:0.6rem;">{p.titulo}</h3>
          <p class="muted">{p.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
