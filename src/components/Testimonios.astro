---
import { landing } from "../data/landing.js";
const { testimonios } = landing;
---
<section class="section section--alt">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:3rem;">{testimonios.titulo}</h2>
    <div class="grid grid-2">
      {testimonios.items.map((t) => (
        <div class="card">
          <p style="font-size:1.2rem;font-family:var(--font-display);margin-bottom:1rem;">"{t.cita}"</p>
          <p class="muted" style="font-size:0.95rem;">{t.autor} — {t.empresa}</p>
        </div>
      ))}
    </div>
  </div>
</section>
