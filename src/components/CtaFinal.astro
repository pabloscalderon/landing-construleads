---
import { landing } from "../data/landing.js";
import Boton from "./Boton.astro";
import Eyebrow from "./Eyebrow.astro";

const { agendar } = landing;
const { campos } = agendar;
---
<section id="agendar" class="fondo-violeta relative overflow-hidden py-20 sm:py-28">
  <div class="estrellas pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="glow left-1/2 top-[-6rem] h-[20rem] w-[36rem] -translate-x-1/2 opacity-40" aria-hidden="true"></div>

  <div class="contenedor relative">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <Eyebrow texto={agendar.eyebrow} centrado />
      <h2 class="mt-5 text-white">{agendar.titulo}</h2>
      <p class="mt-6 max-w-xl text-base text-white/70 sm:text-lg">{agendar.subtitulo}</p>
    </div>

    <div class="mx-auto mt-14 grid max-w-5xl gap-6 lg:grid-cols-2">
      <!-- ============================================================
           FORMULARIO DE CALIFICACIÓN
           >>> CONECTAR ESTE FORMULARIO AL FORMULARIO NATIVO DE CLIENTIFY <<<
           (pegar acá el embed/action del formulario de Clientify;
            no hay lógica de envío propia implementada a propósito)
           ============================================================ -->
      <div class="rounded-3xl border border-white/12 bg-black/30 p-7 backdrop-blur-sm sm:p-9">
        <form id="form-calificacion" class="flex flex-col gap-4" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="nombre" class="text-xs font-medium uppercase tracking-wider text-white/60">{campos.nombre}</label>
              <input class="campo" type="text" id="nombre" name="nombre" autocomplete="name" placeholder={campos.nombre} required />
            </div>
            <div class="flex flex-col gap-2">
              <label for="empresa" class="text-xs font-medium uppercase tracking-wider text-white/60">{campos.empresa}</label>
              <input class="campo" type="text" id="empresa" name="empresa" autocomplete="organization" placeholder={campos.empresa} required />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="text-xs font-medium uppercase tracking-wider text-white/60">{campos.email}</label>
            <input class="campo" type="email" id="email" name="email" autocomplete="email" placeholder="nombre@empresa.com" required />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="whatsapp" class="text-xs font-medium uppercase tracking-wider text-white/60">{campos.whatsapp}</label>
              <input class="campo" type="tel" id="whatsapp" name="whatsapp" autocomplete="tel" placeholder="+54 9 11 0000 0000" required />
            </div>
            <div class="flex flex-col gap-2">
              <label for="cargo" class="text-xs font-medium uppercase tracking-wider text-white/60">{campos.cargo}</label>
              <input class="campo" type="text" id="cargo" name="cargo" autocomplete="organization-title" placeholder="Gerente de tráfico" required />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="volumen" class="text-xs font-medium uppercase tracking-wider text-white/60">{campos.volumen}</label>
            <select class="campo" id="volumen" name="volumen" required>
              <option value="" selected disabled>Elegí una opción</option>
              {agendar.volumenOpciones.map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>

          <div class="mt-2">
            <Boton texto={agendar.botonTexto} variante="verde" tipo="submit" />
          </div>

          <p class="text-xs text-white/50">{agendar.legal}</p>
        </form>
      </div>

      <!-- ============================================================
           CALENDARIO DE AGENDAMIENTO (Clientify)
           ============================================================ -->
      <div class="rounded-3xl border border-white/12 bg-black/30 p-7 backdrop-blur-sm sm:p-9">
        <h3 class="text-white">{agendar.calendario.titulo}</h3>
        <p class="mt-2 text-sm text-white/60">{agendar.calendario.texto}</p>

        <!-- Contenedor donde Clientify monta el calendario -->
        <div id="clientify-calendar" class="mt-6 min-h-[420px] rounded-2xl"></div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       SCRIPT DEL CALENDARIO DE CLIENTIFY — PEGAR TAL CUAL ACÁ:
       <script type="text/javascript" src="https://app.clientify.com/meetings/script/v2/14950.js"></script>
       ============================================================ -->
</section>

<script>
  // ============================================================
  // TRACKING DE CONVERSIONES (placeholders)
  // window.track() está definido en src/layouts/Base.astro
  // ============================================================

  // --- Lead: envío del formulario ---
  // NOTA: el envío real lo maneja Clientify una vez conectado el formulario
  // nativo. Acá solo queda marcado dónde disparar el evento.
  const form = document.getElementById("form-calificacion");
  form?.addEventListener("submit", () => {
    // >>> Meta Pixel: 'Lead' (replicar por CAPI con el mismo event_id)
    // >>> Google Ads: gtag('event','conversion',{send_to: meta.gtagConversionLead})
    // >>> GA4: generate_lead
    window.track?.("Lead", {
      content_name: "Formulario calificación viajes",
      volumen: (document.getElementById("volumen") as HTMLSelectElement | null)?.value || "",
    });
  });

  // --- Schedule: reunión agendada vía Clientify ---
  // Clientify avisa el agendamiento por postMessage desde su iframe.
  // Ajustar la condición cuando se confirme el payload real del widget.
  window.addEventListener("message", (evento) => {
    const datos = typeof evento.data === "string" ? evento.data : JSON.stringify(evento.data ?? "");
    if (!/clientify/i.test(evento.origin) || !/meeting|booked|scheduled/i.test(datos)) return;
    // >>> Meta Pixel: 'Schedule' (replicar por CAPI con el mismo event_id)
    // >>> Google Ads: gtag('event','conversion',{send_to: meta.gtagConversionSchedule})
    window.track?.("Schedule", { content_name: "Reunión agendada Clientify" });
  });
</script>
